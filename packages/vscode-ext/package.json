{
  "name": "vscode-git-notes",
  "displayName": "git-notes",
  "description": "Decentralized code comments, review discussions, and GitHub notes inline inside VS Code, Cursor, and Windsurf IDEs",
  "version": "0.1.12",
  "publisher": "isaim0011",
  "icon": "icon.png",
  "author": { "name": "Bimo", "email": "i.s41m0011@gmail.com" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaim0011/git-notes"
  },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["SCM Providers", "Other"],
  "keywords": [
    "git",
    "notes",
    "git-notes",
    "git notes",
    "gitnotes",
    "github notes",
    "github-notes",
    "bgt-notes",
    "code review",
    "comments",
    "review",
    "cursor",
    "ide",
    "discussion",
    "inline comments",
    "decentralized"
  ],
  "activationEvents": ["workspaceContains:.git"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target node --external vscode",
    "typecheck": "tsc --noEmit",
    "test": "echo no tests yet"
  },
  "contributes": {
    "commands": [
      { "command": "git-notes.add", "title": "git-notes: Add Note" },
      { "command": "git-notes.list", "title": "git-notes: List Notes" },
      { "command": "git-notes.sync", "title": "git-notes: Sync Notes" },
      { "command": "git-notes.showPanel", "title": "git-notes: Show Note Thread" }
    ],
    "keybindings": [
      {
        "command": "git-notes.add",
        "key": "alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus"
      },
      {
        "command": "git-notes.showPanel",
        "key": "alt+shift+n",
        "mac": "cmd+alt+shift+n",
        "when": "editorTextFocus"
      },
      {
        "command": "git-notes.sync",
        "key": "alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "menus": {
      "editor/context": [
        { "command": "git-notes.add", "group": "git-notes" },
        { "command": "git-notes.showPanel", "group": "git-notes" }
      ]
    },
    "configuration": {
      "title": "git-notes",
      "properties": {
        "git-notes.binaryPath": { "type": "string", "default": "git-notes", "description": "Path to the git-notes CLI binary" },
        "git-notes.autoSync": { "type": "boolean", "default": false, "description": "Auto-sync notes on save" },
        "git-notes.defaultNamespace": { "type": "string", "default": "comments", "enum": ["comments", "review", "todos"] }
      }
    },
    "walkthroughs": [
      {
        "id": "git-notes.welcome",
        "title": "Getting Started with git-notes",
        "description": "Learn how to use decentralized, git-native code annotations and review workflows.",
        "steps": [
          {
            "id": "git-notes.init",
            "title": "Initialize Repository",
            "description": "Configure your git refspec and sync hooks for seamless decentralized note sharing.",
            "media": {
              "markdown": "walkthrough/init.md"
            },
            "completionEvents": [
              "onCommand:git-notes.sync"
            ]
          },
          {
            "id": "git-notes.addNote",
            "title": "Add Inline Code Notes",
            "description": "Anchor discussions, todos, and reviews to code lines using Alt+N.",
            "media": {
              "markdown": "walkthrough/notes.md"
            },
            "completionEvents": [
              "onCommand:git-notes.add"
            ]
          },
          {
            "id": "git-notes.threads",
            "title": "Interactive Discussion Threads",
            "description": "View rich threaded discussions and resolve comments using Alt+Shift+N.",
            "media": {
              "markdown": "walkthrough/threads.md"
            },
            "completionEvents": [
              "onCommand:git-notes.showPanel"
            ]
          },
          {
            "id": "git-notes.sync",
            "title": "Sync, Rebase Heal & CI Gate",
            "description": "Synchronize with git remotes, heal after rebases, and gate merges in CI.",
            "media": {
              "markdown": "walkthrough/sync.md"
            },
            "completionEvents": [
              "onCommand:git-notes.sync"
            ]
          }
        ]
      }
    ]
  }
}
